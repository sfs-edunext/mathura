function invokeActionConfirmationDeleteRefreshLoadAndShowDeleted(str, targeturl, title) {
    var r = confirm("Do you want to delete" + title + " ?")
    if (r == true) {
        selectpostRequestAndShowDeleted(str, targeturl);
