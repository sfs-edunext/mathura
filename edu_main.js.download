function invokeActionPromptRefreshAndLoad(str, targeturl, msg) {

    var remarks = prompt(msg, '');
    if (remarks == null) {
        return;
    } else if (remarks == '') {
        invokeActionPromptRefreshAndLoad(str, targeturl, msg);
    } else {
        str = str + "&remarks=" + remarks;
        selectpostRequest(str, targeturl);
    }

}

