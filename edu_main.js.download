    }
}

function tableformcheckboxvalue(target) {
    var checked = target.checked;
    if (target.checked) {
        var elementname = target.name;

        if (elementname.indexOf("select_") != -1) {
            var value = elementname.substring(7, elementname.length);
            target.value = value;
        } else {
