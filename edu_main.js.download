                console.log("extenstion[" + extenstion + "]");
                var res = extenstion.split(",");
                var ext = $(this).val().split('.').pop().toLowerCase();
                if ($.inArray(ext, res) == -1) {
                    var message = "The Attachment should be in " + extenstion + " format.";
                    showErrorMessageDiv(message);
