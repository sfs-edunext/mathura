function block_image(div) {
    $(div).block({
        message: '<i class="icon-spinner9 spinner"></i>',
        overlayCSS: {
            backgroundColor: '#fff',
            opacity: 0.8,
            cursor: 'wait',
            position: top
        },
        css: {
            border: 0,
            padding: 0,
            backgroundColor: 'none',
            position: top
        }
    });
}

function hide_processing_image(current_obj) {
    var div = $(current_obj).parent();
    un_block_image(div);
}

